; ============================================================================
; Buff 容器：耐久度下方,法术护盾上方,作为状态显示行。
;   顶端 = BottomLeft 顶 - 148 = 屏幕高-160 + (-148) = 屏幕高-308
;   底端 = BottomLeft 顶 - 64  = 屏幕高-160 + (-64)  = 屏幕高-224
;   BuffContainer 实际高度 84 = 64(图标) + 20(计时文字)
;   与 MagicShieldBar 顶端(屏幕高-180)间距 44 像素,倒数文字与盾条不再重叠。
; 与 BottomLeftExtras 底端(屏幕高-432)间距 124 像素,耐久度与 Buff 不再重叠。
; ============================================================================
[node name="BuffContainer" type="HBoxContainer" parent="BottomLeft" unique_name_in_owner = true]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 0
offset_left = 0.0
offset_top = -148.0
offset_right = 320.0
offset_bottom = -64.0
theme_override_constants/separation = 8
