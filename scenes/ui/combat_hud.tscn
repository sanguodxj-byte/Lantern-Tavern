; ============================================================================
; BottomLeftExtras：远端旧版 (commit 77a30b1b) 的耐久度容器。
; 整块上移到 BuffContainer 上方,避免耐久度与 Buff 倒数文字/盾条重合。
;   BuffContainer 顶 ≈ 屏幕高-260, 底 ≈ 屏幕高-176(包含 20 像素计时条 + 文字)
;   BottomLeftExtras 顶 = 屏幕高-500, 底 = 屏幕高-432
;   两者间距 = (屏幕高-260) - (屏幕高-432) = 172px gap(充足分离)
; 武器图标 y=0..32，耐久 y=8..24；盾牌图标 y=36..68，耐久 y=44..60。
; ============================================================================
[node name="BottomLeftExtras" type="Control" parent="."]
layout_mode = 3
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = -500.0
offset_right = 240.0
offset_bottom = -432.0
grow_vertical = 0
theme = ExtResource("13_theme")
texture_filter = 1

[node name="WeaponIcon" type="TextureRect" parent="BottomLeftExtras"]
visible = false
offset_left = 0.0
offset_top = 0.0
offset_right = 32.0
offset_bottom = 32.0
texture = ExtResource("10_tick")

[node name="WeaponIndicator" parent="BottomLeftExtras" instance=ExtResource("8_stat")]
