[gd_scene load_steps=4 format=3 uid="uid://chest_loot_panel_v1"]

[ext_resource type="Script" path="res://scenes/ui/chest_loot_panel.gd" id="1_script"]
[ext_resource type="Theme" path="res://scenes/ui/lantern_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="CornerStud"]
bg_color = Color(0.94, 0.62, 0.22, 0.95)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0, 0, 0, 0.8)
corner_radius_top_left = 1
corner_radius_top_right = 1
corner_radius_bottom_right = 1
corner_radius_bottom_left = 1
corner_detail = 1
anti_aliasing = false

[node name="ChestLootPanel" type="CanvasLayer"]
layer = 30
script = ExtResource("1_script")

; ============================================================================
; 背景遮罩(暗哑)
; ============================================================================
[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
theme = ExtResource("2_theme")
texture_filter = 1

[node name="DimBackground" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
color = Color(0, 0, 0, 0.55)

; ============================================================================
; LootFrame —— Tarkov/Barony 风格主面板
;   - 4px 黑金属外框
;   - 紧贴视口左右各留 24px 边距
;   - 顶部 32px,底部 24px 边距
;   - 整体尺寸 = 视口宽 - 48, 视口高 - 56
; ============================================================================
[node name="LootFrame" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 32.0
offset_right = -24.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"LootFrame"

[node name="Margin" type="MarginContainer" parent="Root/LootFrame"]
layout_mode = 2
theme_override_constants/margin_left = 4
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 4
theme_override_constants/margin_bottom = 4

[node name="LootBody" type="PanelContainer" parent="Root/LootFrame/Margin"]
layout_mode = 2
theme_type_variation = &"LootSectionAlt"

[node name="Margin2" type="MarginContainer" parent="Root/LootFrame/Margin/LootBody"]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="VBox" type="VBoxContainer" parent="Root/LootFrame/Margin/LootBody/Margin2"]
layout_mode = 2
theme_override_constants/separation = 6

; ── 标题区(LootHeader:带底边的琥珀高光) ──
[node name="Header" type="PanelContainer" parent="Root/LootFrame/Margin/LootBody/Margin2/VBox"]
layout_mode = 2
theme_type_variation = &"LootHeader"

[node name="HeaderRow" type="HBoxContainer" parent="Root/LootFrame/Margin/LootBody/Margin2/VBox/Header"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="Root/LootFrame/Margin/LootBody/Margin2/VBox/Header/HeaderRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"LootTitle"
text = "LOOT"

[node name="ItemCount" type="Label" parent="Root/LootFrame/Margin/LootBody/Margin2/VBox/Header/HeaderRow"]
