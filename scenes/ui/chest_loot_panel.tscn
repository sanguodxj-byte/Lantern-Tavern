layout_mode = 2
theme_type_variation = &"LootHint"
text = ""
horizontal_alignment = 2
vertical_alignment = 1

[node name="StatusLabel" type="Label" parent="Root/LootFrame/Margin/LootBody/Margin2/VBox/Header/HeaderRow"]
unique_name_in_owner = true
